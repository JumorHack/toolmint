---
import ToolLayout from "../../layouts/ToolLayout.astro";
---

<ToolLayout toolId="password-generator">
  <div class="tool-shell">
    <div class="field">
      <label for="pg-out">Your password</label>
      <input id="pg-out" type="text" readonly value="" style="font-family:monospace; font-size:1.15rem;" />
    </div>
    <div class="btn-row">
      <button class="btn" id="pg-gen">↻ Generate</button>
      <button class="btn secondary" data-copy="#pg-out">Copy</button>
      <span id="pg-strength" style="align-self:center; font-weight:700;"></span>
    </div>
    <div class="field" style="margin-top:18px;">
      <label>Length: <span id="pg-len-label">16</span> characters</label>
      <input id="pg-len" type="range" min="4" max="64" value="16" />
    </div>
    <div class="checkbox-row">
      <label><input type="checkbox" id="pg-upper" checked> Uppercase (A-Z)</label>
      <label><input type="checkbox" id="pg-lower" checked> Lowercase (a-z)</label>
      <label><input type="checkbox" id="pg-num" checked> Numbers (0-9)</label>
      <label><input type="checkbox" id="pg-sym" checked> Symbols (!@#)</label>
    </div>
  </div>

  <script is:inline>
    (function () {
      const out = document.getElementById("pg-out");
      const len = document.getElementById("pg-len");
      const lenLabel = document.getElementById("pg-len-label");
      const strength = document.getElementById("pg-strength");
      const sets = {
        upper: "ABCDEFGHJKLMNPQRSTUVWXYZ",
        lower: "abcdefghijkmnpqrstuvwxyz",
        num: "23456789",
        sym: "!@#$%^&*()-_=+[]{};:,.?",
      };
      function pool() {
        let p = "";
        if (document.getElementById("pg-upper").checked) p += sets.upper;
        if (document.getElementById("pg-lower").checked) p += sets.lower;
        if (document.getElementById("pg-num").checked) p += sets.num;
        if (document.getElementById("pg-sym").checked) p += sets.sym;
        return p;
      }
      function gen() {
        const p = pool();
        if (!p) { out.value = "Select at least one option"; strength.textContent = ""; return; }
        const n = parseInt(len.value, 10);
        const arr = new Uint32Array(n);
        crypto.getRandomValues(arr);
        let s = "";
        for (let i = 0; i < n; i++) s += p[arr[i] % p.length];
        out.value = s;
        const bits = Math.round(n * Math.log2(p.length));
        const label = bits < 40 ? "Weak" : bits < 70 ? "Good" : bits < 110 ? "Strong" : "Very strong";
        const color = bits < 40 ? "var(--danger)" : bits < 70 ? "#f0b429" : "var(--ok)";
        strength.textContent = label + " · " + bits + " bits";
        strength.style.color = color;
      }
      len.addEventListener("input", () => { lenLabel.textContent = len.value; gen(); });
      document.querySelectorAll("#pg-upper,#pg-lower,#pg-num,#pg-sym").forEach((c) => c.addEventListener("change", gen));
      document.getElementById("pg-gen").addEventListener("click", gen);
      gen();
    })();
  </script>
</ToolLayout>
