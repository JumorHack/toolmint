---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
---

<BaseLayout title="Page Not Found" description="The page you are looking for could not be found." noindex={true}>
  <section class="hero container">
    <h1>404</h1>
    <p>Sorry, we couldn't find that page. It may have moved or never existed.</p>
    <div class="btn-row" style="justify-content:center; margin-top:18px;">
      <a class="btn" href="/">Back to {SITE.name}</a>
      <a class="btn secondary" href="/tools/">Browse tools</a>
    </div>
  </section>
</BaseLayout>
