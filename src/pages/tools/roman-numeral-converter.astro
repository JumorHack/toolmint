---
import ToolLayout from "../../layouts/ToolLayout.astro";
---

<ToolLayout toolId="roman-numeral-converter">
  <div class="tool-shell">
    <h3 style="margin-top:0;">Number → Roman numerals</h3>
    <div class="converter-row" style="grid-template-columns:1fr 1fr;">
      <div class="field"><label for="rm-num">Number (1–3,999,999)</label><input id="rm-num" type="number" value="2026" min="1" max="3999999" /></div>
      <div class="field"><label for="rm-rom-out">Roman numerals</label><div class="result-box" id="rm-rom-out" style="font-size:1.1rem;">—</div></div>
    </div>
  </div>

  <div class="tool-shell" style="margin-top:16px;">
    <h3 style="margin-top:0;">Roman numerals → Number</h3>
    <div class="converter-row" style="grid-template-columns:1fr 1fr;">
      <div class="field"><label for="rm-rom">Roman numerals</label><input id="rm-rom" type="text" value="MMXXVI" /></div>
      <div class="field"><label for="rm-num-out">Number</label><div class="result-box" id="rm-num-out" style="font-size:1.1rem;">—</div></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const $ = (id) => document.getElementById(id);
      function base(n) {
        const th = ["", "M", "MM", "MMM"];
        const hu = ["", "C", "CC", "CCC", "CD", "D", "DC", "DCC", "DCCC", "CM"];
        const te = ["", "X", "XX", "XXX", "XL", "L", "LX", "LXX", "LXXX", "XC"];
        const on = ["", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX"];
        return th[Math.floor(n / 1000)] + hu[Math.floor((n % 1000) / 100)] + te[Math.floor((n % 100) / 10)] + on[n % 10];
      }
      const overline = (s) => s.split("").map((c) => c + "\u0305").join("");
      function toRoman(n) {
        if (n <= 0) return "";
        if (n < 4000) return base(n);
        return overline(toRoman(Math.floor(n / 1000))) + base(n % 1000);
      }
      function fromRoman(str) {
        const map = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };
        let big = "", small = "";
        const chars = [...str.toUpperCase()];
        for (let i = 0; i < chars.length; i++) {
          if (chars[i] === "\u0305") continue;
          if (chars[i + 1] === "\u0305") big += chars[i];
          else small += chars[i];
        }
        const r2n = (s) => {
          let total = 0;
          for (let i = 0; i < s.length; i++) {
            const cur = map[s[i]], next = map[s[i + 1]];
            if (cur == null) return null;
            if (next && cur < next) { total += next - cur; i++; } else total += cur;
          }
          return total;
        };
        const b = r2n(big), s = r2n(small);
        if (b == null || s == null) return null;
        return b * 1000 + s;
      }
      function calcNum() {
        const n = Math.floor(+$("rm-num").value);
        $("rm-rom-out").textContent = n >= 1 && n <= 3999999 ? toRoman(n) : "Enter 1–3,999,999";
      }
      function calcRom() {
        const v = $("rm-rom").value.trim();
        if (!v) { $("rm-num-out").textContent = "—"; return; }
        const n = fromRoman(v);
        $("rm-num-out").textContent = n == null || n === 0 ? "Invalid numerals" : n.toLocaleString();
      }
      $("rm-num").addEventListener("input", calcNum);
      $("rm-rom").addEventListener("input", calcRom);
      calcNum(); calcRom();
    })();
  </script>
</ToolLayout>
