---
import ToolLayout from "../../layouts/ToolLayout.astro";
---

<ToolLayout toolId="number-base-converter">
  <div class="tool-shell">
    <div class="field"><label for="nb-dec">Decimal (base 10)</label><input id="nb-dec" type="text" value="2026" inputmode="numeric" /></div>
    <div class="field"><label for="nb-bin">Binary (base 2)</label><input id="nb-bin" type="text" /></div>
    <div class="field"><label for="nb-oct">Octal (base 8)</label><input id="nb-oct" type="text" /></div>
    <div class="field"><label for="nb-hex">Hexadecimal (base 16)</label><input id="nb-hex" type="text" style="text-transform:uppercase;" /></div>
    <p style="color:var(--muted); font-size:.85rem; margin:4px 0 0;">Supports non-negative integers of any size.</p>
  </div>

  <script is:inline>
    (function () {
      const $ = (id) => document.getElementById(id);
      const fields = {
        "nb-dec": { re: /^[0-9]+$/, prefix: "", radix: 10n, out: 10 },
        "nb-bin": { re: /^[01]+$/, prefix: "0b", radix: 2n, out: 2 },
        "nb-oct": { re: /^[0-7]+$/, prefix: "0o", radix: 8n, out: 8 },
        "nb-hex": { re: /^[0-9a-fA-F]+$/, prefix: "0x", radix: 16n, out: 16 },
      };
      function update(srcId) {
        const src = fields[srcId];
        const raw = $(srcId).value.trim();
        if (raw === "") { Object.keys(fields).forEach((id) => { if (id !== srcId) $(id).value = ""; }); return; }
        if (!src.re.test(raw)) { Object.keys(fields).forEach((id) => { if (id !== srcId) $(id).value = "⚠ invalid"; }); return; }
        let n;
        try { n = BigInt(src.prefix + raw); } catch (e) { return; }
        Object.keys(fields).forEach((id) => {
          if (id === srcId) return;
          let s = n.toString(fields[id].out);
          if (id === "nb-hex") s = s.toUpperCase();
          $(id).value = s;
        });
      }
      Object.keys(fields).forEach((id) => $(id).addEventListener("input", () => update(id)));
      update("nb-dec");
    })();
  </script>
</ToolLayout>
