---
import ToolLayout from "../../layouts/ToolLayout.astro";
---

<ToolLayout toolId="random-number-generator">
  <div class="tool-shell">
    <div class="converter-row" style="grid-template-columns:1fr 1fr 1fr;">
      <div class="field"><label for="rn-min">Minimum</label><input id="rn-min" type="number" value="1" /></div>
      <div class="field"><label for="rn-max">Maximum</label><input id="rn-max" type="number" value="100" /></div>
      <div class="field"><label for="rn-count">How many</label><input id="rn-count" type="number" value="1" min="1" max="1000" /></div>
    </div>
    <div class="checkbox-row" style="margin-bottom:14px;">
      <label><input type="checkbox" id="rn-uniq"> No duplicates</label>
    </div>
    <div class="btn-row">
      <button class="btn" id="rn-gen">Generate</button>
      <button class="btn secondary" data-copy="#rn-out">Copy</button>
    </div>
    <div class="field" style="margin-top:14px;">
      <label for="rn-out">Result</label>
      <textarea id="rn-out" readonly></textarea>
    </div>
  </div>

  <script is:inline>
    (function () {
      const $ = (id) => document.getElementById(id);
      const rint = (min, max) => { const a = new Uint32Array(1); crypto.getRandomValues(a); return min + (a[0] % (max - min + 1)); };
      function gen() {
        let min = Math.floor(+$("rn-min").value), max = Math.floor(+$("rn-max").value);
        if (min > max) { [min, max] = [max, min]; }
        let count = Math.min(1000, Math.max(1, Math.floor(+$("rn-count").value) || 1));
        const uniq = $("rn-uniq").checked;
        const range = max - min + 1;
        if (uniq && count > range) { $("rn-out").value = `Cannot pick ${count} unique numbers from a range of ${range}.`; return; }
        const out = [];
        if (uniq) {
          const seen = new Set();
          while (out.length < count) { const n = rint(min, max); if (!seen.has(n)) { seen.add(n); out.push(n); } }
        } else {
          for (let i = 0; i < count; i++) out.push(rint(min, max));
        }
        $("rn-out").value = out.join(count > 20 ? ", " : "\n");
      }
      $("rn-gen").addEventListener("click", gen);
      gen();
    })();
  </script>
</ToolLayout>
